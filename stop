#!/bin/bash
set -e

cd "$(dirname "$0")"

echo "Stopping uvicorn..."
if [ -f uvicorn.pid ]; then
    kill "$(cat uvicorn.pid)" 2>/dev/null && rm -f uvicorn.pid
    echo "  Stopped (PID $(cat uvicorn.pid 2>/dev/null || echo 'unknown'))"
else
    pkill -f "uvicorn manage:app" 2>/dev/null || \
    taskkill //F //IM python.exe //FI "WINDOWTITLE eq uvicorn" 2>/dev/null || \
    echo "  No uvicorn process found"
fi

echo "Stopping PostgreSQL..."
if command -v pg_ctl &> /dev/null; then
    pg_ctl stop -D "$(brew --prefix 2>/dev/null || echo /usr/local)/var/postgresql@16" 2>/dev/null || \
    echo "  (PostgreSQL may not be running)"
elif command -v net &> /dev/null; then
    net stop postgresql-x64-16 2>/dev/null || echo "  (PostgreSQL may not be running)"
fi

echo "Done."
